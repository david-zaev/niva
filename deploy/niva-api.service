[Unit]
Description=Niva FastAPI backend
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/opt/niva/backend
EnvironmentFile=-/opt/niva/.env
ExecStart=/opt/niva/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
